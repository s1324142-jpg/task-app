# FirebaseのWebアプリ設定（Firebase Console > Project settings）。これらは公開クライアント設定であり、秘密鍵ではありません。
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Androidアプリ設定を差し替える場合のみ指定します。未指定時はgoogle-services.jsonと同じ組み込み値を使います。
EXPO_PUBLIC_FIREBASE_ANDROID_API_KEY=
EXPO_PUBLIC_FIREBASE_ANDROID_APP_ID=

# Google Cloud / Firebaseで作成した「ウェブ アプリケーション」OAuthクライアントID。
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# manabaのID・パスワード、Cookie、サービスアカウント秘密鍵は絶対に記載しないでください。
